# =============================================================================
# LifeOS — variáveis de ambiente
#
# 1. Copie este arquivo para .env.local (que fica FORA do Git).
# 2. Preencha com os valores do SEU projeto Supabase:
#    Project Settings → Data API → Project URL
#    Project Settings → API Keys → Publishable key (sb_publishable_…)
#      (projetos antigos: aba "Legacy API keys" → anon public)
# 3. Reinicie `npm run dev`.
#
# Tudo que começa com VITE_ vai para o navegador e é PÚBLICO por definição.
# NUNCA coloque aqui a secret key (sb_secret_…) nem a service_role: elas ignoram o
# RLS. O app se recusa a iniciar se detectar uma delas.
# =============================================================================

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Opcional — testes de integração (npm run test:integration).
# Coloque em .env.test.local (fora do Git) as credenciais de DUAS contas de teste
# criadas pelo próprio app, com e-mail confirmado. Não use sua conta pessoal.
# -----------------------------------------------------------------------------
# LIFEOS_TEST_A_EMAIL=
# LIFEOS_TEST_A_PASSWORD=
# LIFEOS_TEST_B_EMAIL=
# LIFEOS_TEST_B_PASSWORD=
