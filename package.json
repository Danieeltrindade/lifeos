{
  "name": "lifeos",
  "private": true,
  "version": "0.1.0",
  "description": "LifeOS — sistema pessoal de organização, estudos, produtividade, planejamento e autoconhecimento.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "themes": "node scripts/generate-themes.mjs && prettier --write src/styles/themes.css",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:stack": "vitest run --config vitest.integration.config.ts --mode stack",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "db:test:local": "bash supabase/tests/local/run.sh",
    "stack:start": "bash supabase/stack/start.sh",
    "stack:stop": "bash supabase/stack/stop.sh",
    "db:link": "npx --yes supabase@2 link",
    "db:push": "npx --yes supabase@2 db push",
    "db:types": "npx --yes supabase@2 gen types typescript --linked --schema public > src/services/supabase/database.types.ts && prettier --write src/services/supabase/database.types.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.5",
    "@fullcalendar/core": "^6.1.19",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@fullcalendar/react": "^6.1.19",
    "@fullcalendar/timegrid": "^6.1.19",
    "@hookform/resolvers": "^5.2.1",
    "@supabase/supabase-js": "^2.57.4",
    "@tanstack/react-query": "^5.90.0",
    "@tiptap/extension-highlight": "^3.32.2",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-list": "^3.32.2",
    "@tiptap/extension-text-style": "^3.32.2",
    "@tiptap/extensions": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "lucide-react": "^1.60.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.62.0",
    "react-router": "^7.18.0",
    "recharts": "^3.10.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  }
}
